{
  "name": "pdf-privado-windows",
  "productName": "PDF Privado",
  "version": "1.0.0",
  "description": "PDF Privado: herramientas PDF 100% locales para Windows.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node prepare-web.js",
    "start": "npm run prepare-web && electron .",
    "selftest": "npm run prepare-web && electron . --selftest",
    "dist": "npm run prepare-web && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pdfprivado.win",
    "productName": "PDF Privado",
    "executableName": "PDF Privado",
    "files": ["main.js", "web/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "PDF-Privado-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082"
    },
    "fileAssociations": [
      { "ext": "pdf", "name": "PDF", "role": "Viewer" }
    ]
  }
}
